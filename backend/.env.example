# 1. Copy this file and rename it to .env
# 2. Update the environment variables below.

# REQUIRED SETTINGS - DATABASE
# #############################
# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gaming_voice_chat
DB_USER=root
DB_PASSWORD=

# Alternative: Full database URL (if preferred over individual components)
# DATABASE_URL=mysql://root:password@localhost:3306/gaming_voice_chat

# REQUIRED SETTINGS - SERVER
# ###########################
# Backend server configuration
SERVER_PORT=8080
GIN_MODE=debug

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OPTIONAL SETTINGS
# #################
# Database connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m